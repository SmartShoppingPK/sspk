# Copy this file to .env.local and fill in the values.

# Base URL of the site. Use http://localhost:3000 for now, swap for the real domain later.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header, footer, legal pages
NEXT_PUBLIC_SITE_NAME=My Shop
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER put NEXT_PUBLIC_ in front of this one. Used to count clicks.
SUPABASE_SERVICE_ROLE_KEY=
